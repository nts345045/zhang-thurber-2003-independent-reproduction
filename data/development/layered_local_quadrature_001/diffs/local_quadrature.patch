+// Quadrature uses q in (0,1) within each stored [a,b]. The endpoint choice
+// conditions the arithmetic; it imposes no physical constraint on the curve.
+class PieceSampler {
+  const Piece &piece;
+  const Meridional endpoint;
+  const Real end_angle;
+public:
+  explicit PieceSampler(const Piece &p):piece(p),endpoint(p.at(1)),
+    end_angle(p.kind==PieceKind::affine_arc ? p.theta0+p.sweep : 0) {}
+
+  Meridional from_end(Real distance) const {
+    require(finite(distance) && distance>=0 && distance<=1,
+            "Endpoint-relative parameter outside [0,1]");
+    if (distance==0) return endpoint;
+    if (piece.kind!=PieceKind::affine_arc)
+      return {endpoint.r-(piece.r1-piece.r0)*distance,
+              endpoint.z-(piece.z1-piece.z0)*distance};
+    Real half=piece.sweep*distance/2;
+    Real chord=2*std::sin(half)/piece.kappa;
+    return {endpoint.r-chord*std::sin(end_angle-half),
+            endpoint.z-chord*std::cos(end_angle-half)};
+  }
+
+  Meridional at_interval(Real a,Real b,Real q) const {
+    require(finite(a) && finite(b) && a>=0 && a<b && b<=1,
+            "Invalid local curve interval");
+    require(finite(q) && q>0 && q<1, "Local Gauss coordinate outside (0,1)");
+    // Compare distances of the interval midpoint from the two endpoints
+    // without forming that midpoint. Ties use the original forward formula.
+    if (a<=1-b) return piece.at(a+(b-a)*q);
+    return from_end((1-b)+(b-a)*(1-q));
+  }
+};
 
